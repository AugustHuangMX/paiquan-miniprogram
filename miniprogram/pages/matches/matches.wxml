<view class="wrap theme-{{theme}}" data-lang="{{lang}}">

  <!-- 自定义导航栏：⚙ 常驻左上角，和地图页一模一样（用户 2026-10 的决定）。
       微信原生导航栏不接受任何自定义元素，所以整条自己画。 -->
  <view class="navbar" style="padding-top: {{navTop}}px; height: {{navH}}px;">
    <view class="navbtn {{panelOpen ? 'navbtn-on' : ''}}" bindtap="onTogglePanel">⚙</view>
    <text class="navtitle">{{T.navMatches}}</text>
    <view class="navspace" style="width: {{navRight}}px;"></view>
  </view>

  <!-- 设置面板：这一页只需要语言和主题（模式筛选是地图页特有的） -->
  <view wx:if="{{panelOpen}}" class="panel">
    <view class="panel-t">{{T.panelLang}}</view>
    <view class="panel-row">
      <view class="langsw">
        <view class="langsw-i langsw-l {{lang === 'zh' ? 'langsw-on' : ''}}" data-l="zh" bindtap="onLang">中文</view>
        <view class="langsw-i langsw-r {{lang === 'en' ? 'langsw-on' : ''}}" data-l="en" bindtap="onLang">EN</view>
      </view>
    </view>
    <view class="panel-t">{{T.panelTheme}}</view>
    <view class="panel-row">
      <view class="langsw">
        <view class="langsw-i langsw-l {{theme === 'dark' ? 'langsw-on' : ''}}" data-t="dark" bindtap="onTheme">{{T.themeDark}}</view>
        <view class="langsw-i langsw-r {{theme === 'light' ? 'langsw-on' : ''}}" data-t="light" bindtap="onTheme">{{T.themeLight}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{err.kind}}" class="msg msg-{{err.style}}">
    <text class="msg-title">{{err.title}}</text>
    <text class="msg-body">{{err.message}}</text>
  </view>

  <!-- ================= 比赛专区 · 下一场比赛 =================
       2026-10-18 用户要求：一打开先看到「未来最近一场比赛」的分组与时间安排；
       官方还没排期时只显示分组；点队伍看队员。
       数据是离线快照（utils/next_match_data.js，由 直播识别/build_next_match.mjs 生成），
       所以"还有几天"由视图模型按**打开页面的时刻**算，界面不写死。 -->
  <block wx:if="{{next}}">
    <view class="sec-title">
      {{T.nextTitle}}
      <text class="sec-hint">{{next.updatedText}}</text>
    </view>

    <view class="nx-hero">
      <view class="nx-hero-top">
        <view class="nx-hero-l">
          <text class="nx-event">{{next.eventLabel}}</text>
          <text class="nx-sub">{{next.eventSub}}</text>
        </view>
        <view wx:if="{{next.hasStatus}}" class="nx-pill {{next.hasNext ? '' : 'nx-pill-off'}}">{{next.statusText}}</view>
      </view>
      <view class="nx-next">
        <text class="nx-next-k">{{T.nextMatchLabel}}</text>
        <text class="nx-next-time">{{next.nextTimeText}}</text>
        <text class="nx-next-name">{{next.nextMatchText}}</text>
      </view>
      <view class="nx-meta">{{next.metaText}}</view>
    </view>

    <!-- 赛制：赛事页 info-banner 的转写（官方英文原文里写死的晋级路径）。
         默认收起 —— 展开会占掉小半屏，而"下一场几点"才是打开这一页的第一需求。 -->
    <view wx:if="{{next.format}}" class="nx-fmt" bindtap="onFormat" hover-class="nx-fmt-hover">
      <view class="nx-fmt-h">
        <text class="nx-fmt-t">{{T.nextFormat}}</text>
        <text class="nx-fmt-x">{{fmtOpen ? '▴' : '▾'}}</text>
      </view>
      <text class="nx-fmt-s">{{next.format.summary}}</text>
      <block wx:if="{{fmtOpen}}">
        <view class="nx-fmt-row" wx:for="{{next.format.lines}}" wx:key="k">
          <text class="nx-fmt-k">{{item.k}}</text>
          <text class="nx-fmt-v">{{item.v}}</text>
        </view>
      </block>
    </view>

    <!-- 时间安排：一场一格（日期 + 时间 + 场次），两列排。
         官方一场都没排时间时**整块不渲染**（用户要求：那就只显示分组），
         分组标题下面会写一句说明；排了部分场次时，没排的用「时间待定」的格子列在后面。 -->
    <view wx:if="{{next.hasTimes}}" class="pblock">
      <view class="pblock-h">
        <text class="pblock-t">{{T.nextSchedule}}</text>
        <text class="pblock-n">{{next.tzText}}</text>
      </view>
      <view class="nx-slots">
        <view class="nx-slot" wx:for="{{next.slots}}" wx:key="key">
          <text class="nx-slot-t">{{item.label}}</text>
          <text class="nx-slot-n">{{item.name}}</text>
        </view>
        <view class="nx-slot" wx:for="{{next.untimed}}" wx:for-item="r" wx:key="key">
          <text class="nx-slot-t">{{T.nextUntimed}}</text>
          <text class="nx-slot-n">{{r.name}}</text>
        </view>
      </view>
    </view>

    <!-- 分组：A/B/C/D 四个组，一屏内只展开当前组（40 支队一次铺开没法读）；
         组标签上带队伍数，所以"分组"这件事一打开就看得到。 -->
    <view class="pblock">
      <view class="pblock-h">
        <text class="pblock-t">{{T.nextGroups}}</text>
        <text class="pblock-n">{{T.nextGroupsHint}}</text>
      </view>
      <view wx:if="{{!next.hasTimes}}" class="nx-note">{{next.noTimeNote}}</view>
      <view class="nx-tabs">
        <view wx:for="{{next.groups}}" wx:key="key"
              class="nx-tab {{item.active ? 'nx-tab-on' : ''}}"
              data-k="{{item.key}}" bindtap="onNextGroup">
          <text class="nx-tab-k">{{item.name}}</text>
          <text class="nx-tab-n">{{item.countText}}</text>
        </view>
      </view>
      <!-- 当前组的出场安排：换组就跟着换（A 组 → 10/30 01:00 vs B …） -->
      <view wx:if="{{next.activeMatchesText}}" class="nx-gsched">{{next.activeMatchesText}}</view>
      <view class="nx-grid">
        <view class="nx-team" wx:for="{{next.teams}}" wx:key="name"
              data-i="{{index}}" bindtap="onTeam" hover-class="nx-team-hover">
          <image wx:if="{{item.hasIcon}}" class="nx-team-ic" src="{{item.icon}}" mode="aspectFit"></image>
          <text class="nx-team-n">{{item.name}}</text>
          <text class="nx-team-x">›</text>
        </view>
      </view>
    </view>

    <view class="note">{{next.caveat}}</view>
  </block>

  <!-- 广告位：未配置 unit-id 时整个组件不渲染（见 utils/ad.js）。
       放在「下一场比赛」之后、「ALGS 赛场」之前 —— 这是本页第一个真正的分段处；
       原来贴在页脚上方，等于没人看得到（曝光只来自滚动中途）。 -->
  <view class="adbox">
    <ad wx:if="{{adUnit}}" unit-id="{{adUnit}}" ad-intervals="60" binderror="onAdError"></ad>
  </view>

  <!-- ================= ALGS 职业赛场 =================
       官方赛事（冠军赛 / 季后赛 / 职业联赛…）的赛后统计：战队名次 + 英雄选取率 +
       三人组合。和上面两块一样是**本地离线快照**（algs_data.js），不联网。
       为什么只能是快照：数据源除赛事页外都有人机校验，云函数取不到 —— 见 utils/algs.js。 -->
  <block wx:if="{{algs}}">
    <view class="sec-title">
      {{T.algsTitle}}
      <text class="sec-hint">{{algs.updatedText}}</text>
    </view>

    <scroll-view class="prochips" scroll-x="true" enable-flex="true">
      <view wx:for="{{algs.chips}}" wx:key="id" data-id="{{item.id}}" bindtap="onAlgsChip"
            class="prochip {{item.active ? 'prochip-on' : ''}}">{{item.name}}</view>
    </scroll-view>

    <block wx:if="{{algs.ev}}">
      <!-- 赛事头：赛事名 + 赛季/赛区 + 冠军 -->
      <view class="algs-head">
        <view class="algs-head-l">
          <text class="algs-name">{{algs.ev.label}}</text>
          <text class="algs-sub">{{algs.ev.sub}}</text>
          <view class="algs-meta">
            <text wx:if="{{algs.ev.teamsText}}" class="algs-meta-i">{{algs.ev.teamsText}}</text>
            <text wx:if="{{algs.ev.gamesText}}" class="algs-meta-i">{{algs.ev.gamesText}}</text>
          </view>
        </view>
        <view wx:if="{{algs.ev.championText}}" class="algs-head-r">
          <text class="algs-champ-k">{{algs.ev.championLabel}}</text>
          <text class="algs-champ-v">{{algs.ev.championText}}</text>
        </view>
      </view>

      <view wx:if="{{algs.ev.mapsText}}" class="algs-maps">{{T.algsMaps}} · {{algs.ev.mapsText}}</view>

      <!-- 战队排名：名次口径写在标题右边（决赛名次 / 阶段名次 / 累计积分） -->
      <view wx:if="{{algs.ev.hasStandings}}" class="pblock">
        <view class="pblock-h"><text class="pblock-t">{{T.algsStandings}}</text></view>
        <!-- 口径说明单独占一行：这句比较长，塞进标题右边会把「战队排名」挤成两行 -->
        <view class="algs-note">{{algs.ev.rankNote}}</view>
        <view class="srow {{item.top3 ? 'srow-top3' : ''}}" wx:for="{{algs.ev.standings}}" wx:key="rank">
          <text class="srow-rank">{{item.rank}}</text>
          <text class="srow-team">{{item.team}}</text>
          <text wx:if="{{item.winsText}}" class="srow-wins">{{item.winsText}}</text>
          <text class="srow-score">{{item.scoreText}}</text>
        </view>
      </view>

      <!-- 英雄选取率：和「排位专区」同一套视觉（头像 + 条形 + 百分比），
           但**用自己的 .acell**，不复用那边的 .hcell —— 那边是一行五格的固定卡，
           两处混用会互相牵制（见 predator.wxss 里的说明）。 -->
      <view wx:if="{{algs.ev.hasLegends}}" class="pblock">
        <view class="pblock-h">
          <text class="pblock-t">{{T.algsLegends}}</text>
          <text class="pblock-n">{{algs.ev.legendTotalText}}</text>
        </view>
        <view class="agrid">
          <view wx:for="{{algs.ev.legends}}" wx:key="key" class="acell">
            <view class="acell-pic">
              <image wx:if="{{item.hasIcon}}" class="acell-ic" src="{{item.icon}}" mode="aspectFill"></image>
            </view>
            <text class="acell-name">{{item.main}}</text>
            <view class="acell-bar"><view class="acell-fill" style="width: {{item.bar}}%"></view></view>
            <text class="acell-pct">{{item.pctText}}</text>
          </view>
        </view>
      </view>

      <!-- 三人组合：同样是三个头像并排 -->
      <view wx:if="{{algs.ev.hasCombos}}" class="pblock">
        <view class="pblock-h"><text class="pblock-t">{{T.algsCombos}}</text></view>
        <view class="crow" wx:for="{{algs.ev.combos}}" wx:key="key">
          <view class="crow-avs">
            <image wx:if="{{item.hasAvatars}}" wx:for="{{item.avatars}}" wx:for-item="av" wx:key="*this"
                   class="crow-av" src="{{av}}" mode="aspectFill"></image>
          </view>
          <view class="crow-txt">
            <text class="crow-name">{{item.text}}</text>
            <view class="crow-bar"><view class="crow-fill" style="width: {{item.bar}}%"></view></view>
          </view>
          <view class="crow-v">
            <text class="crow-pct">{{item.pctText}}</text>
            <text class="crow-n">{{item.nText}}</text>
          </view>
        </view>
      </view>

      <view class="note">{{algs.caveat}}</view>
    </block>
  </block>

  <!-- ⚠️ 这里原来还有**第二个**广告位（贴页脚上方）。
       一页两块广告既打扰阅读、又容易被判"密集投放"，
       已删除；本页只保留上面「下一场比赛之后」那一处。 -->

  <view class="foot">
    {{T.foot1}}
    {{T.foot2}}
  </view>

  <!-- 队伍 → 队员弹层。点遮罩或「关闭」收起；catchtap 拦住冒泡，
       否则点弹层内部也会被遮罩的 bindtap 关掉。 -->
  <view wx:if="{{openTeam}}" class="nx-mask" bindtap="onCloseTeam" catchtouchmove="noop">
    <view class="nx-sheet" catchtap="noop">
      <view class="nx-sheet-h">
        <view class="nx-sheet-hl">
          <view class="nx-sheet-title">
            <image wx:if="{{openTeam.hasIcon}}" class="nx-sheet-ic" src="{{openTeam.icon}}" mode="aspectFit"></image>
            <view class="nx-sheet-txt">
              <text class="nx-sheet-name">{{openTeam.name}}</text>
              <text class="nx-sheet-sub">{{openTeam.groupName}}<text wx:if="{{openTeam.hasPlayers}}"> · {{openTeam.countText}}</text></text>
            </view>
          </view>
        </view>
        <view class="nx-sheet-x" bindtap="onCloseTeam">{{T.nextClose}}</view>
      </view>
      <block wx:if="{{openTeam.hasPlayers}}">
        <view class="nx-player" wx:for="{{openTeam.players}}" wx:key="name">
          <text class="nx-player-n">{{item.name}}</text>
          <text wx:if="{{item.meta}}" class="nx-player-m">{{item.meta}}</text>
        </view>
      </block>
      <view wx:else class="nx-note">{{T.nextNoRoster}}</view>
    </view>
  </view>
</view>
