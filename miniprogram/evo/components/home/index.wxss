/* 首页顶上那块。共用的（.evo-grow / .evo-dim / .evo-rp-*）在 evo/evo.wxss；
   卡片、并排、进度条（.hcard / .hpair / .hbar）用首页的 pages/home/home.wxss（apply-shared） */
@import "../../evo.wxss";

.evo-hm-skel { height: 360rpx; }
.evo-hm-k { font-size: var(--fs-sub); color: var(--ink2); }
.evo-hm-strong { font-weight: var(--fw-bold); color: var(--ink); }
.evo-hm-row { display: flex; align-items: center; justify-content: space-between; }

/* ---------- 没绑定 ---------- */
.evo-hm-head { display: flex; align-items: flex-start; }
.evo-hm-ic { flex: none; width: 72rpx; height: 72rpx; margin-right: var(--sp-5); }
.evo-hm-title { display: block; font-size: var(--fs-head); font-weight: var(--fw-bold); color: var(--ink); }
.evo-hm-body { display: block; margin-top: var(--sp-2); font-size: var(--fs-body); color: var(--ink2); }
.evo-hm-steps { display: flex; align-items: stretch; margin-top: var(--sp-6); }
.evo-hm-step {
  flex: 1;
  min-width: 0;
  margin-right: var(--sp-3);
  padding: var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--raised);
}
.evo-hm-step-end { margin-right: 0; }
.evo-hm-step-n { display: block; font-size: var(--fs-body); font-weight: var(--fw-num); color: var(--accent-ink); }
.evo-hm-step-t { display: block; margin-top: var(--sp-1); font-size: var(--fs-sub); color: var(--ink); line-height: 1.45; }
.evo-hm-btns { display: flex; margin-top: var(--sp-6); }
/* 两个按钮都 ≥ 88rpx 高（无障碍要求热区 ≥ 80rpx） */
.evo-hm-scan {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  margin-right: var(--sp-4);
  text-align: center;
  border-radius: var(--r-lg);
  background: var(--accent);
  color: #ffffff;
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
}
.evo-hm-learn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-lg);
  background: var(--raised);
  color: var(--ink);
  font-size: var(--fs-body);
}
.evo-hm-note { display: block; margin-top: var(--sp-5); font-size: var(--fs-min); color: var(--ink3); line-height: 1.6; }

/* ---------- 我的段位 ---------- */
.evo-hm-sync { display: flex; align-items: center; font-size: var(--fs-min); color: var(--ink2); }
.evo-hm-dot { width: 12rpx; height: 12rpx; margin-right: var(--sp-2); border-radius: var(--r-full); background: var(--up); }
.evo-hm-rank { display: flex; align-items: center; margin-top: var(--sp-4); }
.evo-hm-emblem { position: relative; flex: none; width: 112rpx; height: 112rpx; margin-right: var(--sp-5); }
.evo-hm-emblem-img { width: 112rpx; height: 112rpx; }
/* 段数写在徽章底部的铭牌上（同「我的战绩」）：位置按每个段位量好的铭牌中心摆 */
.evo-hm-numeral {
  position: absolute;
  transform: translate(-50%, -50%);
  line-height: 1;
  color: #ffffff;
  font-weight: var(--fw-num);
}
.evo-hm-letter {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  margin-right: var(--sp-5);
  text-align: center;
  border-radius: var(--r-lg);
  background: var(--raised);
  font-size: var(--fs-title);
  font-weight: var(--fw-num);
}
.evo-hm-tier { display: block; font-size: var(--fs-head); font-weight: var(--fw-bold); color: var(--ink); line-height: 1.3; }
.evo-hm-num { display: flex; align-items: baseline; margin-top: var(--sp-1); }
.evo-hm-big { font-size: var(--fs-big); font-weight: var(--fw-num); line-height: 1.15; color: var(--ink); font-variant-numeric: tabular-nums; }
.evo-hm-unit { margin-left: var(--sp-2); font-size: var(--fs-sub); color: var(--ink2); }
.evo-hm-today { flex: none; display: flex; flex-direction: column; align-items: flex-end; margin-left: var(--sp-4); }
.evo-hm-prog { background: var(--prog); }
.evo-hm-steprow { margin-top: var(--sp-3); font-size: var(--fs-min); color: var(--ink2); }

/* ---------- 今日 / 上一局 ---------- */
.evo-hm-kv { display: flex; justify-content: space-between; margin-top: var(--sp-2); font-size: var(--fs-sub); color: var(--ink2); }
.evo-hm-place { color: var(--accent-ink); }
.evo-hm-lastrp { margin-left: var(--sp-3); font-size: var(--fs-body); font-weight: var(--fw-bold); }
/* 分享按钮：图标 40rpx，按钮本身 72rpx（热区）。
   微信的 button 自带宽 184px、左右内边距和底色（选择器比类名更具体），所以这几项要 !important 才压得住 */
.evo-hm-share {
  flex: none;
  width: 72rpx !important;
  height: 72rpx;
  margin: 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  background: var(--raised) !important;
  line-height: 1;
}
.evo-hm-share::after { border: none; }
.evo-hm-share-ic { width: 40rpx; height: 40rpx; }
.evo-hm-lg { display: flex; align-items: center; margin-top: var(--sp-3); }
.evo-hm-face { flex: none; width: 56rpx; height: 56rpx; border-radius: var(--r-full); background: var(--raised); }
.evo-hm-face-t { line-height: 56rpx; text-align: center; font-size: var(--fs-min); font-weight: var(--fw-bold); color: var(--ink); }
.evo-hm-lgname { min-width: 0; margin-left: var(--sp-3); font-size: var(--fs-body); font-weight: var(--fw-bold); color: var(--ink); }
.evo-hm-line { display: block; margin-top: var(--sp-3); font-size: var(--fs-sub); color: var(--ink2); line-height: 1.45; }
