/* 「我的战绩」组件。共用的（列表行、名次、按钮、账号切换）在 evo/evo.wxss */
@import "../../evo.wxss";

.evo-skel-rank { height: 280rpx; }
.evo-skel-chart { height: 360rpx; }
.evo-start-b { display: block; font-size: var(--fs-body); color: var(--ink2); margin-bottom: var(--sp-4); }

/* ---------- 没绑定 ---------- */
.evo-step { display: flex; align-items: flex-start; margin-bottom: var(--sp-3); }
.evo-step-n {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: var(--sp-4);
  text-align: center;
  border-radius: var(--r-full);
  background: var(--raised);
  font-size: var(--fs-min);
  font-weight: var(--fw-bold);
}
.evo-step-t { flex: 1; font-size: var(--fs-sub); color: var(--ink2); }
.evo-site { color: var(--ink2); font-weight: var(--fw-bold); }

/* ---------- 待确认提示 ---------- */
.evo-review { display: flex; align-items: center; }
.evo-go { flex: none; margin-left: var(--sp-4); font-weight: var(--fw-bold); }

/* ---------- 段位 ---------- */
.evo-rank { display: flex; align-items: center; }
.evo-emblem { position: relative; flex: none; width: 160rpx; height: 160rpx; margin-right: var(--sp-6); }
.evo-emblem-img { width: 160rpx; height: 160rpx; }
/* 段数写在徽章底部的铭牌上（同 Evo 窗口）：位置按每个段位量好的铭牌中心摆 */
.evo-numeral {
  position: absolute;
  transform: translate(-50%, -50%);
  line-height: 1;
  color: #ffffff;
  font-weight: var(--fw-num);
}
.evo-letter {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  margin-right: var(--sp-6);
  text-align: center;
  border-radius: var(--r-lg);
  background: var(--raised);
  font-size: var(--fs-title);
  font-weight: var(--fw-num);
}
.evo-rank-name { display: block; font-size: var(--fs-title); font-weight: var(--fw-bold); line-height: 1.3; }
.evo-rank-rp { margin: var(--sp-1) 0; }
.evo-rank-n { font-size: var(--fs-head); font-weight: var(--fw-num); font-variant-numeric: tabular-nums; }
.evo-unit { margin-left: var(--sp-2); font-size: var(--fs-min); color: var(--ink3); }

.evo-minis { display: flex; margin-top: var(--sp-5); padding-top: var(--sp-4); border-top: 1rpx solid var(--track); }
.evo-mini { flex: 1; min-width: 0; }
.evo-mini-v { display: block; font-size: var(--fs-section); font-weight: var(--fw-num); font-variant-numeric: tabular-nums; }
/* ---------- RP 走势 ---------- */
.evo-range { margin-left: auto; }
.evo-chart { width: 100%; height: 280rpx; }
.evo-chart-foot { display: flex; justify-content: space-between; margin-top: var(--sp-2); font-size: var(--fs-min); color: var(--ink3); }

/* ---------- 统计数字：3 列 × 2 行 ---------- */
.evo-stats { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: var(--sp-1); }
.evo-stat {
  width: 32%;
  box-sizing: border-box;
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
}
.evo-stat-v { display: block; font-size: var(--fs-head); font-weight: var(--fw-num); font-variant-numeric: tabular-nums; }
.evo-accent { color: var(--accent-ink); }

/* ---------- 对局列表 ---------- */
.evo-link { color: var(--accent-ink); }
/* ---------- 传奇表现 ---------- */
.evo-lg { margin-bottom: var(--sp-5); }
.evo-lg-line { display: flex; align-items: center; margin-bottom: var(--sp-2); }
.evo-lg-name { flex: 1; min-width: 0; font-size: var(--fs-body); font-weight: var(--fw-bold); }
.evo-lg-meta { flex: none; font-size: var(--fs-min); color: var(--ink3); }
.evo-bar { display: flex; height: 16rpx; border-radius: var(--r-full); overflow: hidden; background: var(--track); }
.evo-seg { height: 100%; }
.evo-seg-p1 { background: var(--accent); }
.evo-seg-p2 { background: var(--warn); }
.evo-seg-p3 { background: var(--info-ink); }
.evo-seg-p4 { background: var(--ink3); }
.evo-keys { display: flex; flex-wrap: wrap; font-size: var(--fs-min); color: var(--ink3); }
.evo-key { display: flex; align-items: center; margin-right: var(--sp-6); }
.evo-dot { width: 16rpx; height: 16rpx; margin-right: var(--sp-2); border-radius: var(--r-full); }
